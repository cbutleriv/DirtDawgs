---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Sponsors are tiered by donation size. Ones with a logo render the
// image; individuals/donors without a logo render a name card.
const allSponsors = (await getCollection('sponsors')).sort(
  (a, b) => a.data.order - b.data.order,
);

const TIER_DEFS = [
  { key: 'lead',      label: 'Lead Partner',    boxClass: 'logo-box--lg', gridClass: 'tier-grid--lead' },
  { key: 'gold',      label: 'Gold Sponsors',   boxClass: 'logo-box--lg', gridClass: 'tier-grid--3'    },
  { key: 'silver',    label: 'Silver Sponsors', boxClass: 'logo-box--md', gridClass: 'tier-grid--3'    },
  { key: 'community', label: 'Community',        boxClass: 'logo-box--sm', gridClass: 'tier-grid--4'    },
] as const;

const tiers = TIER_DEFS.map((t, i) => ({
  ...t,
  num: String(i + 2).padStart(2, '0'),
  sponsors: allSponsors.filter((s) => s.data.tier === t.key).map((s) => s.data),
})).filter((t) => t.sponsors.length > 0);

const perks = [
  { num: '01', title: 'Brand on jerseys', body: 'Your logo worn by players at every tournament and practice throughout the season.' },
  { num: '02', title: 'Field-side signage', body: 'Banners and signage at home-field games and select tournaments.' },
  { num: '03', title: 'Quarterly community feature', body: 'Recognition in program communications, social media, and the website sponsor page.' },
] as const;
---

<BaseLayout
  title="Sponsors — Bakersfield Dirt Dawgs"
  description="Partners who support the Bakersfield Dirt Dawgs youth baseball program. Learn how to become a sponsor."
  canonicalPath="/sponsors"
>

  <!-- ════════════════════════════════════════════════════════════
       01 · PAGE HEADER
  ════════════════════════════════════════════════════════════ -->
  <section class="sponsors-header">
    <div class="page-header-photo" role="img" aria-label="Dirt Dawgs mascot on the infield" style="background-image: url('/images/ending-frame.jpeg');"></div>
    <div class="page-header-overlay" aria-hidden="true"></div>
    <div class="container page-header-content">
      <p class="sponsors-eyebrow">Sponsors</p>
      <h1 class="sponsors-h1">Partners in the Program.</h1>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       02+ · SPONSOR TIERS (data-driven: Lead / Gold / Silver / Community)
  ════════════════════════════════════════════════════════════ -->
  {tiers.map((tier, i) => (
    <section class={`tier-section${i % 2 === 1 ? ' section-cream' : ''}`}>
      <div class="container">
        <Eyebrow num={tier.num}>{tier.label}</Eyebrow>
        <div class={`tier-grid ${tier.gridClass} reveal`}>
          {tier.sponsors.map((s) => (
            <div class={`logo-box ${tier.boxClass}`}>
              {s.logo ? (
                <Image src={s.logo} alt={s.name} width={360} class="logo-img" />
              ) : (
                <span class="logo-name">{s.name}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- ════════════════════════════════════════════════════════════
       05 · BECOME A SPONSOR
  ════════════════════════════════════════════════════════════ -->
  <section class="become-section bg-dark">
    <div class="container">
      <Eyebrow num="06" dark>Become a Sponsor</Eyebrow>
      <div class="become-grid reveal">
        <div class="become-left">
          <h2 class="become-heading">Become a Sponsor.</h2>
          <p class="become-body">
            Support a local development program. Your name on the dugout fence, the bus, and the season — and a direct investment in the players and families that make up this community.
          </p>
        </div>
        <div class="become-right">
          <div class="perks-list">
            {perks.map((perk) => (
              <div class="perk">
                <span class="perk-num">— {perk.num}</span>
                <h3 class="perk-title">{perk.title}</h3>
                <p class="perk-body">{perk.body}</p>
              </div>
            ))}
          </div>
          <Button href="/contact" variant="secondary" dark>Contact Us</Button>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .section-cream { background-color: var(--color-cream); }

  /* ── 01 · Header ─────────────────────────────────────── */
  .sponsors-header {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-py);
    border-bottom: 1px solid var(--color-divider-d);
    background-color: var(--color-navy);
  }

  .sponsors-eyebrow {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 16px;
  }

  .sponsors-h1 {
    font-family: var(--font-serif);
    font-size: var(--fs-h1);
    font-weight: 600;
    color: var(--color-offwhite);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    margin: 0;
  }

  /* ── Sponsor tiers ───────────────────────────────────── */
  .tier-section {
    padding-block: var(--section-py);
  }

  .tier-grid {
    display: grid;
    gap: 20px;
    margin-top: 40px;
    align-items: center;
  }

  .tier-grid--2    { grid-template-columns: repeat(2, 1fr); }
  .tier-grid--3    { grid-template-columns: repeat(3, 1fr); }
  .tier-grid--4    { grid-template-columns: repeat(4, 1fr); }
  .tier-grid--6    { grid-template-columns: repeat(6, 1fr); }
  .tier-grid--lead {
    grid-template-columns: minmax(0, 460px);
    justify-content: center;
  }

  .logo-box {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-divider);
    background: var(--color-offwhite);
    padding: 20px;
  }

  .logo-box--lg { aspect-ratio: 3 / 2; }
  .logo-box--md { aspect-ratio: 2 / 1; }
  .logo-box--sm { aspect-ratio: 2 / 1; }

  /* Actual sponsor logo — contained inside the box regardless of shape */
  .logo-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Name card for donors without a logo (individuals, etc.) */
  .logo-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(14px, 1.4vw, 19px);
    color: var(--color-navy);
    text-align: center;
    line-height: 1.3;
    text-wrap: balance;
  }

  .logo-placeholder {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  /* ── 05 · Become section ─────────────────────────────── */
  .become-section {
    padding-block: var(--section-py);
  }

  .become-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
    margin-top: 48px;
  }

  .become-heading {
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    font-weight: 400;
    color: var(--color-offwhite);
    line-height: 1.1;
    margin: 0 0 20px;
    text-wrap: balance;
  }

  .become-body {
    font-size: 15px;
    color: rgba(250, 250, 247, 0.72);
    line-height: 1.75;
    margin: 0;
    max-width: 46ch;
  }

  .perks-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 36px;
  }

  .perk {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .perk-num {
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.22em;
    color: var(--color-gold);
  }

  .perk-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    font-weight: 400;
    color: var(--color-offwhite);
    margin: 0;
    line-height: 1.25;
  }

  .perk-body {
    font-size: 14px;
    color: rgba(250, 250, 247, 0.65);
    line-height: 1.65;
    margin: 4px 0 0;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 1024px) {
    .tier-grid--6 { grid-template-columns: repeat(3, 1fr); }
    .tier-grid--4 { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 768px) {
    .tier-grid--2  { grid-template-columns: 1fr; }
    .tier-grid--3  { grid-template-columns: 1fr; }
    .tier-grid--4  { grid-template-columns: repeat(2, 1fr); }
    .tier-grid--6  { grid-template-columns: repeat(2, 1fr); }
    .become-grid   { grid-template-columns: 1fr; gap: 40px; }
  }
</style>

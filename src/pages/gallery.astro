---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import GalleryGrid from '../components/sections/GalleryGrid';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';

// Load gallery photos from the content collection, optimize each image
// (originals are multi-MB), and hand plain URLs to the React island.
const entries = (await getCollection('gallery')).sort(
  (a, b) => a.data.order - b.data.order,
);

const photos = await Promise.all(
  entries.map(async (entry) => {
    const optimized = await getImage({
      src: entry.data.image,
      width: 1400,
      format: 'webp',
    });
    return {
      src: optimized.src,
      alt: entry.data.alt,
      caption: entry.data.caption,
      category: entry.data.category,
    };
  }),
);
---

<BaseLayout
  title="Gallery — Bakersfield Dirt Dawgs"
  description="Photos from Bakersfield Dirt Dawgs games, practice, and team moments throughout the season."
  canonicalPath="/gallery"
>

  <!-- ════════════════════════════════════════════════════════════
       01 · PAGE HEADER
  ════════════════════════════════════════════════════════════ -->
  <section class="gallery-header">
    <div class="page-header-photo" role="img" aria-label="Dirt Dawgs mascot on the infield" style="background-image: url('/images/ending-frame.jpeg');"></div>
    <div class="page-header-overlay" aria-hidden="true"></div>
    <div class="container page-header-content">
      <p class="gallery-eyebrow">Gallery</p>
      <h1 class="gallery-h1">Moments in the Dirt.</h1>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       02–03 · FILTER + GRID (React island)
  ════════════════════════════════════════════════════════════ -->
  <section class="gallery-main">
    <div class="container">
      <div class="reveal">
        <Eyebrow num="02">Photos</Eyebrow>
        <GalleryGrid photos={photos} client:load />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── 01 · Header ─────────────────────────────────────── */
  .gallery-header {
    position: relative;
    padding-block: var(--section-py);
    border-bottom: 1px solid var(--color-divider-d);
    background-color: var(--color-navy);
    overflow: hidden;
  }


  .gallery-eyebrow {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 16px;
  }

  .gallery-h1 {
    font-family: var(--font-serif);
    font-size: var(--fs-h1);
    font-weight: 600;
    color: var(--color-offwhite);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    margin: 0;
  }

  /* ── 02–03 · Main section ────────────────────────────── */
  .gallery-main {
    padding-block: var(--section-py);
  }

  /* Filter chips */
  :global(.gallery-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 32px 0 40px;
  }

  :global(.gallery-chip) {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 8px 16px;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-pill);
    background: var(--color-offwhite);
    color: var(--color-ink-2);
    cursor: pointer;
    transition:
      background var(--duration-base) var(--ease-brand),
      border-color var(--duration-base) var(--ease-brand),
      color var(--duration-base) var(--ease-brand);
  }

  :global(.gallery-chip:hover) {
    border-color: var(--color-navy);
    color: var(--color-navy);
  }

  :global(.gallery-chip--active) {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-offwhite);
  }

  /* Masonry grid — CSS columns */
  :global(.gallery-masonry) {
    columns: 3;
    column-gap: 16px;
  }

  :global(.gallery-item) {
    display: block;
    width: 100%;
    break-inside: avoid;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  :global(.gallery-img) {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--duration-slow) var(--ease-brand);
  }

  :global(.gallery-item:hover .gallery-img) {
    transform: scale(1.02);
  }

  :global(.gallery-caption) {
    position: absolute;
    inset: 0;
    background: rgba(11, 27, 59, 0);
    display: flex;
    align-items: flex-end;
    padding: 20px 16px 16px;
    transition: background var(--duration-base) var(--ease-brand);
    border: 1px solid transparent;
    transition:
      background var(--duration-base) var(--ease-brand),
      border-color var(--duration-base) var(--ease-brand);
  }

  :global(.gallery-item:hover .gallery-caption) {
    background: rgba(11, 27, 59, 0.55);
    border-color: var(--color-navy);
  }

  :global(.gallery-caption-text) {
    font-size: 13px;
    color: var(--color-offwhite);
    line-height: 1.4;
    margin: 0;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--duration-base) var(--ease-brand),
      transform var(--duration-base) var(--ease-brand);
  }

  :global(.gallery-item:hover .gallery-caption-text) {
    opacity: 1;
    transform: translateY(0);
  }

  /* Load more */
  :global(.gallery-load-wrap) {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }

  :global(.gallery-load-btn) {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 14px 32px;
    background: var(--color-offwhite);
    border: 1.5px solid var(--color-navy);
    border-radius: var(--radius-sm);
    color: var(--color-navy);
    cursor: pointer;
    transition:
      background var(--duration-base) var(--ease-brand),
      color var(--duration-base) var(--ease-brand);
  }

  :global(.gallery-load-btn:hover) {
    background: var(--color-cream);
  }

  /* Lightbox */
  :global(.lightbox-overlay) {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.92);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.lightbox-inner) {
    position: relative;
    max-width: min(90vw, 1100px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  :global(.lightbox-img) {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    display: block;
  }

  :global(.lightbox-close) {
    position: absolute;
    top: -40px;
    right: 0;
    font-size: 20px;
    color: var(--color-offwhite);
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    padding: 4px 8px;
    opacity: 0.7;
    transition: opacity var(--duration-fast) var(--ease-brand);
  }

  :global(.lightbox-close:hover) {
    opacity: 1;
  }

  :global(.lightbox-nav) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 40px;
    font-weight: 200;
    color: var(--color-offwhite);
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 16px;
    opacity: 0.6;
    transition: opacity var(--duration-fast) var(--ease-brand);
    line-height: 1;
  }

  :global(.lightbox-nav:hover:not(:disabled)) {
    opacity: 1;
  }

  :global(.lightbox-nav:disabled) {
    opacity: 0.2;
    cursor: default;
  }

  :global(.lightbox-nav--prev) {
    left: -64px;
  }

  :global(.lightbox-nav--next) {
    right: -64px;
  }

  :global(.lightbox-caption) {
    font-size: 13px;
    color: rgba(250, 250, 247, 0.65);
    text-align: center;
    margin: 14px 0 0;
    line-height: 1.5;
    max-width: 60ch;
  }

  /* Photo count stat */
  :global(.gallery-stat) {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    margin: 0 0 32px;
  }

  /* Empty filter state */
  :global(.gallery-empty) {
    padding: 64px 0;
    text-align: center;
  }

  :global(.gallery-empty-text) {
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 768px) {
    :global(.gallery-masonry) {
      columns: 2;
    }

    :global(.lightbox-nav--prev) { left: -44px; }
    :global(.lightbox-nav--next) { right: -44px; }
  }

  @media (max-width: 480px) {
    :global(.gallery-masonry) {
      columns: 1;
    }
  }
</style>

---
// VideoIntro — full-screen splash video, plays once per session on the homepage.
// Dispatches window event 'introComplete' when dismissed so hero animations can fire.
---

<div
  id="video-intro"
  class="vi-overlay"
  role="presentation"
  aria-hidden="true"
>
  <video
    id="intro-video"
    class="vi-video"
    src="/videos/home-intro.mp4"
    autoplay
    muted
    playsinline
    preload="auto"
  ></video>

  <button id="skip-intro" class="vi-skip" type="button" aria-label="Skip intro">
    Skip <span aria-hidden="true">↓</span>
  </button>
</div>

<style>
  .vi-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #0a0a0a;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 800ms ease-in-out;
  }

  .vi-overlay.vi-fading {
    opacity: 0;
    pointer-events: none;
  }

  .vi-overlay.vi-hidden {
    display: none;
  }

  .vi-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vi-skip {
    position: absolute;
    bottom: 36px;
    right: 36px;
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(250, 250, 247, 0.75);
    background: transparent;
    border: 1px solid rgba(250, 250, 247, 0.3);
    padding: 10px 18px;
    cursor: pointer;
    transition: color 220ms ease-out, border-color 220ms ease-out;
  }

  .vi-skip:hover {
    color: rgba(250, 250, 247, 1);
    border-color: rgba(250, 250, 247, 0.65);
  }

  .vi-skip:focus-visible {
    outline: 1.5px solid var(--color-gold);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .vi-overlay {
      background: #0B1B3B;
    }

    .vi-video {
      object-fit: contain;
    }
  }

  @media (max-width: 540px) {
    .vi-skip {
      bottom: 24px;
      right: 20px;
    }
  }
</style>

<script>
  (function () {
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);

    const overlay = document.getElementById('video-intro') as HTMLDivElement | null;
    const video   = document.getElementById('intro-video') as HTMLVideoElement | null;
    const skipBtn = document.getElementById('skip-intro') as HTMLButtonElement | null;

    if (!overlay || !video) return;

    // Preload so the image is ready (or nearly ready) when dismiss fires
    const endingImg = new Image();
    endingImg.src = '/images/ending-frame.jpeg';

    function applyEndingFrame() {
      const heroPhoto = document.querySelector<HTMLElement>('.hero .hero-photo');
      if (!heroPhoto) return;

      const navH    = document.getElementById('site-header')?.offsetHeight ?? 0;
      const isMobile = window.innerWidth <= 900;

      heroPhoto.style.backgroundImage  = `url('/images/ending-frame.jpeg')`;
      heroPhoto.style.backgroundRepeat = 'no-repeat';

      if (!isMobile && endingImg.complete && endingImg.naturalWidth > 0) {
        // Mirror the video's object-fit:cover (object-position:50% 50%) exactly,
        // then shift up by navH so the top of the image aligns with the viewport
        // top rather than the hero-section top.
        const vw    = window.innerWidth;
        const vh    = window.innerHeight;
        const scale = Math.max(vw / endingImg.naturalWidth, vh / endingImg.naturalHeight);
        const bw    = endingImg.naturalWidth  * scale;
        const bh    = endingImg.naturalHeight * scale;
        heroPhoto.style.backgroundSize     = `${bw}px ${bh}px`;
        heroPhoto.style.backgroundPosition = `${(vw - bw) / 2}px ${(vh - bh) / 2 - navH}px`;
      } else {
        // Mobile: cover from top — logo is visible and no navy bleed at bottom
        heroPhoto.style.backgroundSize     = 'cover';
        heroPhoto.style.backgroundPosition = 'center top';
      }
    }

    // On BFCache restore: scroll to top and reapply the ending frame
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) {
        window.scrollTo(0, 0);
        applyEndingFrame();
      }
    });

    // --- dismiss ---------------------------------------------------------
    function dismiss() {
      applyEndingFrame();
      sessionStorage.setItem('dd-intro-seen', '1');

      setTimeout(() => {
        overlay!.classList.add('vi-fading');
        setTimeout(() => {
          overlay!.classList.add('vi-hidden');
          window.scrollTo(0, 0);
          window.dispatchEvent(new CustomEvent('introComplete'));
        }, 820);
      }, 150);
    }

    // --- Skip paths -------------------------------------------------------
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const alreadySeen    = sessionStorage.getItem('dd-intro-seen') === '1';

    if (prefersReduced || alreadySeen) {
      overlay.classList.add('vi-hidden');
      window.scrollTo(0, 0);
      applyEndingFrame();
      // Defer so activateHero() in index.astro has time to register its listener
      setTimeout(() => window.dispatchEvent(new CustomEvent('introComplete')), 0);
      return;
    }

    video.addEventListener('ended', dismiss);
    skipBtn?.addEventListener('click', dismiss);
    video.addEventListener('error', () => setTimeout(dismiss, 500));
  })();
</script>

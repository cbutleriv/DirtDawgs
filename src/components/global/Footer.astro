---
import { Image } from 'astro:assets';
import { Instagram, Facebook, Youtube } from 'lucide-react';
import darkBgLogo from '../../assets/logos/dark_bg_logo.png';

const exploreLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/teams', label: 'Teams' },
  { href: '/schedule', label: 'Schedule' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/contact', label: 'Contact' },
];

const programLinks = [
  { href: '/teams/11u', label: '11U / 12U Team' },
  { href: '/teams/10u', label: '10U Team' },
  { href: '/tryouts', label: 'Tryouts' },
];
---

<footer class="site-footer">
  <div class="container">
    <!-- Top grid — 4 columns desktop, 2 mobile -->
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="brand-col">
        <a href="/" aria-label="Bakersfield Dirt Dawgs — home">
          <Image
            src={darkBgLogo}
            alt="Bakersfield Dirt Dawgs"
            width={140}
            height={175}
            class="footer-logo"
            loading="lazy"
          />
        </a>
        <p class="brand-tagline">Bakersfield, CA · USSSA</p>
      </div>

      <!-- Explore column -->
      <div class="footer-col">
        <h2 class="col-heading">Explore</h2>
        <ul class="col-links" role="list">
          {exploreLinks.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Program column -->
      <div class="footer-col">
        <h2 class="col-heading">Program</h2>
        <ul class="col-links" role="list">
          {programLinks.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact column -->
      <div class="footer-col">
        <h2 class="col-heading">Contact</h2>
        <ul class="col-links" role="list">
          <li><a href="mailto:coach@dirtdawgsbaseball.com">coach@dirtdawgsbaseball.com</a></li>
        </ul>
        <!-- Social icons -->
        <div class="social-row" aria-label="Social media links">
          <a
            href="https://instagram.com/bakersfield.dirtdawgs.11u/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="social-link"
          >
            <Instagram size={20} strokeWidth={1.5} />
          </a>
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="social-link"
          >
            <Facebook size={20} strokeWidth={1.5} />
          </a>
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="social-link"
          >
            <Youtube size={20} strokeWidth={1.5} />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom row — verse + copyright -->
    <div class="footer-bottom">
      <div class="verse-block">
        <blockquote class="scripture">
          "Whatever you do, work at it with all your heart, as working for the Lord, not for human
          masters."
        </blockquote>
        <cite class="scripture-cite">Colossians 3:23</cite>
      </div>
      <p class="copyright">© 2026 Bakersfield Dirt Dawgs</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-navy);
    color: var(--color-offwhite);
    padding-block: 80px 40px;
  }

  /* ---- Top grid ---- */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  /* ---- Brand col ---- */
  .footer-logo {
    width: 100px;
    height: auto;
  }

  .brand-tagline {
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgba(250, 250, 247, 0.55);
    margin: 16px 0 0;
  }

  /* ---- Nav columns ---- */
  .col-heading {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgba(250, 250, 247, 0.5);
    margin: 0 0 16px;
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .col-links li {
    margin-bottom: 10px;
  }

  .col-links a {
    color: rgba(250, 250, 247, 0.8);
    text-decoration: none;
    font-size: 14px;
    transition: color var(--duration-base) var(--ease-brand);
  }

  .col-links a:hover {
    color: var(--color-offwhite);
  }

  /* ---- Social icons ---- */
  .social-row {
    display: flex;
    gap: 16px;
    margin-top: 20px;
  }

  .social-link {
    color: rgba(250, 250, 247, 0.55);
    display: flex;
    transition: color var(--duration-base) var(--ease-brand);
  }

  .social-link:hover {
    color: var(--color-offwhite);
  }

  /* ---- Bottom row ---- */
  .footer-bottom {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--color-divider-d);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
  }

  .scripture {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 15px;
    color: rgba(250, 250, 247, 0.72);
    max-width: 540px;
    margin: 0;
    line-height: 1.55;
  }

  .scripture-cite {
    display: block;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgba(250, 250, 247, 0.45);
    margin-top: 8px;
    font-style: normal;
  }

  .copyright {
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgba(250, 250, 247, 0.45);
    margin: 0;
    text-align: right;
    white-space: nowrap;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 540px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .copyright {
      text-align: left;
    }
  }
</style>

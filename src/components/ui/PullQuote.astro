---
/**
 * PullQuote — editorial quote block with 3px gold left-rule.
 * Used on Home (mission excerpt) and About (full mission).
 */
interface Props {
  attribution?: string;
  dark?: boolean;
  class?: string;
}

const { attribution, dark = false, class: className } = Astro.props;
---

<blockquote class:list={['pullquote', { dark }, className]}>
  <div class="rule" aria-hidden="true"></div>
  <div class="body">
    <p class="quote"><slot /></p>
    {attribution && <cite class="attr">{attribution}</cite>}
  </div>
</blockquote>

<style>
  .pullquote {
    display: grid;
    grid-template-columns: 3px 1fr;
    gap: 32px;
    margin: 0;
    align-items: start;
  }

  .rule {
    background: var(--color-gold);
    align-self: stretch;
    min-height: 80px;
  }

  .quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 34px);
    line-height: 1.35;
    color: var(--color-navy);
    margin: 0;
    text-wrap: balance;
  }

  .dark .quote {
    color: var(--color-offwhite);
  }

  .attr {
    display: block;
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-top: 18px;
    font-style: normal;
  }

  .dark .attr {
    color: rgba(250, 250, 247, 0.55);
  }
</style>

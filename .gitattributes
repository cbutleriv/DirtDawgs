# ---------------------------------------------------------------------------
# Git LFS — large binaries live outside the git object store.
# Set up 2026-07-26. Full rationale: "Chas AI OS"/references/sops/git-lfs.md
#
# Working/source media goes to LFS. Anything under public/ is deliberately
# EXCLUDED: it is served by the build, and neither Cloudflare Pages nor a
# Vercel project with the (off-by-default) Git LFS toggle unset will resolve
# LFS pointers at build time. The deploy would ship a ~130-byte text file
# where the video or image should be — a broken live site, not a broken build.
#
# Rule of thumb: if the build serves it, keep it a real file. If it is a
# source asset, a render, or working media, send it to LFS.
#
# Every machine that clones this repo needs git-lfs installed, or these files
# arrive as one-line pointers instead of real content.
# ---------------------------------------------------------------------------

# Video & audio — the main driver
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mkv  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.m4a  filter=lfs diff=lfs merge=lfs -text

# Layered / archived assets
*.psd  filter=lfs diff=lfs merge=lfs -text
*.ai   filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text

# Source photography and renders — working dirs, never served directly
source-assets/**  filter=lfs diff=lfs merge=lfs -text
working-assets/** filter=lfs diff=lfs merge=lfs -text
generations/**    filter=lfs diff=lfs merge=lfs -text

# Build-served assets stay ordinary files. This must come last — later rules
# win in .gitattributes.
public/** !filter !diff !merge
dist/**   !filter !diff !merge
